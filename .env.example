# Philosophy for Everyone — configuration
#
# Copy to `.env` and fill in whichever provider you use:
#     cp .env.example .env
#
# Leave everything blank to run fully offline against the mock provider.
# The pipeline is byte-for-byte the same either way; only the provider swaps.

# mock | openai | azure
# Leave unset to auto-detect: azure if the Azure keys are present, else
# openai if OPENAI_API_KEY is present, else mock.
PHILO_PROVIDER=

# ---- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works here (vLLM, LiteLLM, OpenRouter, …)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=

# ---- Azure OpenAI ---------------------------------------------------------
# Azure routes by *deployment name*, which is not the same as the model name.
# This is the single most common first-run mistake; `philo doctor` checks it.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---- Models (OpenAI only; Azure uses the deployments above) ----------------
PHILO_CHAT_MODEL=gpt-4o
PHILO_EMBED_MODEL=text-embedding-3-small

# ---- Paths ----------------------------------------------------------------
# PHILO_LIBRARY=./library
# PHILO_INDEX=./.philo/index
# PHILO_PROFILES=./profiles

# ---- Retrieval ------------------------------------------------------------
# PHILO_TOP_K=6            passages sent to the model
# PHILO_CANDIDATE_K=24     shortlist size before diversity re-ranking
# PHILO_HYBRID_ALPHA=0.72  1.0 = pure embeddings, 0.0 = pure BM25
# PHILO_MMR_LAMBDA=0.6     1.0 = pure relevance, 0.0 = pure diversity
# PHILO_MIN_SCORE=0.12     below this, answer "not in the library"

# ---- Chunking (re-run `philo ingest --rebuild` after changing) -------------
# PHILO_CHUNK_MIN=320
# PHILO_CHUNK_TARGET=900
# PHILO_CHUNK_MAX=1500

# ---- Generation -----------------------------------------------------------
# PHILO_TEMPERATURE=0.3
# PHILO_MAX_TOKENS=1400
# PHILO_STREAM=true
# PHILO_TIMEOUT=60
# PHILO_MAX_RETRIES=3
