# Philosophy for Everyone — configuration
#
#     cp .env.example .env
#
# An API key is required. Pick any ONE of the four blocks below, or set
# PHILO_PROVIDER=mock to run entirely offline with no key at all.

# ---------------------------------------------------------------------------
# OpenAI — chat + embeddings
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (vLLM, LiteLLM, OpenRouter, …)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=
PHILO_CHAT_MODEL=gpt-5.5
PHILO_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Anthropic (Claude) — chat ONLY
#
# Anthropic publishes no embeddings endpoint, so Claude cannot build the
# index. Pair it with an OpenAI or Gemini key; philo does that automatically
# and `philo doctor` shows which provider owns which half.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
PHILO_ANTHROPIC_MODEL=claude-opus-5
# Claude has no `temperature` — depth is controlled with effort instead.
# low | medium | high | xhigh | max
PHILO_ANTHROPIC_EFFORT=medium

# ---------------------------------------------------------------------------
# Google Gemini — chat + embeddings
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
PHILO_GEMINI_MODEL=gemini-2.5-flash
PHILO_GEMINI_EMBED_MODEL=gemini-embedding-001
# 3072 by default; 768 or 1536 shrink the index at a small accuracy cost.
# PHILO_GEMINI_EMBED_DIM=1536

# ---------------------------------------------------------------------------
# Azure OpenAI — chat + embeddings
#
# Azure routes by *deployment name*, which is not the model name. This is the
# single most common first-run mistake; `philo doctor` checks for it.
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Choosing providers
#
# Unset, philo auto-detects from whichever keys exist, preferring
#   chat:       azure -> openai -> anthropic -> gemini
#   embeddings: azure -> openai -> gemini
# Override either half independently:
# ---------------------------------------------------------------------------
# PHILO_PROVIDER=            # openai | azure | anthropic | gemini | mock
# PHILO_CHAT_PROVIDER=anthropic
# PHILO_EMBED_PROVIDER=openai

# ---- Paths ----------------------------------------------------------------
# PHILO_HOME=~/.philo        # used when not inside a checkout
# PHILO_LIBRARY=./library
# PHILO_INDEX=./.philo/index
# PHILO_PROFILES=./profiles

# ---- Retrieval ------------------------------------------------------------
# PHILO_TOP_K=6              passages sent to the model
# PHILO_HYBRID_ALPHA=0.72    1.0 = pure embeddings, 0.0 = pure BM25
# PHILO_MIN_SCORE=0.12       below this, answer "not in the library"

# ---- Chunking (re-run `philo ingest --rebuild` after changing) -------------
# PHILO_CHUNK_MIN=320
# PHILO_CHUNK_TARGET=900
# PHILO_CHUNK_MAX=1500

# ---- Generation -----------------------------------------------------------
# PHILO_TEMPERATURE=0.3      ignored by Anthropic (see PHILO_ANTHROPIC_EFFORT)
# PHILO_MAX_TOKENS=1400
# PHILO_STREAM=true

# ---- Web ------------------------------------------------------------------
# Required before exposing `philo serve` beyond localhost.
# PHILO_WEB_TOKEN=
# Restrict which chat models the web picker offers (comma separated). Only
# the chat model is ever selectable — embeddings belong to the index.
# PHILO_WEB_MODELS=gpt-4o-mini,claude-haiku-4-5
